 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 * Can be obtained the same way of dmux4way but with more intermediate steps.
 * Probably there are more clever and less verbose solutions.
 */

 CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    // INITIAL

    // a and b initial
    Not(in=sel[0], out=notsel01);
    And(a=true, b=notsel01, out=out1);
    And(a=true, b=sel[0], out=out2);
    And(a=in, b=out1, out=out3);
    And(a=in, b=out2, out=out4);

    // c and d initial
    Not(in=sel[0], out=notsel02);
    And(a=true, b=notsel02, out=out5);
    And(a=true, b=sel[0], out=out6);
    And(a=in, b=out5, out=out7);
    And(a=in, b=out6, out=out8);

    // e and f initial
    Not(in=sel[0], out=notsel03);
    And(a=true, b=notsel03, out=out9);
    And(a=true, b=sel[0], out=out10);
    And(a=in, b=out9, out=out11);
    And(a=in, b=out10, out=out12);

    // g and h initial
    Not(in=sel[0], out=notsel04);
    And(a=true, b=notsel04, out=out13);
    And(a=true, b=sel[0], out=out14);
    And(a=in, b=out13, out=out15);
    And(a=in, b=out14, out=out16);

    // INTERMEDIATE

    // a and b intermediate
    Not(in=sel[1], out=notsel11);
    And(a=true, b=notsel11, out=out17);
    And(a=true, b=notsel11, out=out18);
    And(a=out3, b=out17, out=out19);
    And(a=out4, b=out18, out=out20);

    // c and d intermediate
    And(a=true, b=sel[1], out=out21);
    And(a=true, b=sel[1], out=out22);
    And(a=out7, b=out21, out=out23);
    And(a=out8, b=out22, out=out24);

    // e and f intermediate
    Not(in=sel[1], out=notsel12);
    And(a=true, b=notsel12, out=out25);
    And(a=true, b=notsel12, out=out26);
    And(a=out11, b=out25, out=out27);
    And(a=out12, b=out26, out=out28);

    // g and h intermediate
    And(a=true, b=sel[1], out=out29);
    And(a=true, b=sel[1], out=out30);
    And(a=out15, b=out29, out=out31);
    And(a=out16, b=out30, out=out32);

    // FINAL

    // a,b,c,d final
    Not(in=sel[2], out=notsel2);
    And(a=notsel2, b=out19, out=a);
    And(a=notsel2, b=out20, out=b);
    And(a=notsel2, b=out23, out=c);
    And(a=notsel2, b=out24, out=d);

    // e,f,g,h final
    And(a=sel[2], b=out27, out=e);
    And(a=sel[2], b=out28, out=f);
    And(a=sel[2], b=out31, out=g);
    And(a=sel[2], b=out32, out=h);
}