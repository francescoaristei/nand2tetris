/*
 * 1 when the inputs have opposing values, 0 otherwise.
 * As said the canonical representation is very useful for the chip
 * construction. For example, the canonical representation of the XOR is
 * (a and not(b)) or (not(a) and b). From this it is obvious the creation
 * of the chip.
*/

CHIP Xor {
    IN a,b;
    OUT out;
    PARTS:
    Not(in=b, out=notb);
    Not(in=a, out=nota);
    And(a=a, b=notb, out=out1);
    And(a=nota, b=b, out=out2);
    Or(a=out1, b=out2, out=out);
}