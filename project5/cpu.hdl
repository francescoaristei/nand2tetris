/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 *
 * The instruction format is the following: i xx a cccccc ddd jjj
 * By looking at the proposed architecture and remembering what each instruction (A, C) do and the bits involved is possible to define
 * the necessary hdl.
 *
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:

    // if C instruction (i=0) look at the bit meaning:
    // if instruction[5] = 1 load in A else not
    // if A instruction (i=0) don't look at bit meaning
    And(a=instruction[15], b=instruction[5], out=loadina);


    // if i bit = 0 A instruction (load A register with instruction bits) else
    // load A register with output of ALU to store it
    Mux16(a=instruction, b=outalu, sel=loadina, out=ainput);


    // a bit
    And(a=instruction[15], b=instruction[12], out=is12);

    // write m
    And(a=instruction[15], b=instruction[3], out=is3);

    // d bit
    And(a=instruction[15], b=instruction[4], out=is4);

    // alu bits
    And(a=instruction[15], b=instruction[6], out=is6);
    And(a=instruction[15], b=instruction[7], out=is7);
    And(a=instruction[15], b=instruction[8], out=is8);
    And(a=instruction[15], b=instruction[9], out=is9);
    And(a=instruction[15], b=instruction[10], out=is10);
    And(a=instruction[15], b=instruction[11], out=is11);

    // jump bits
    And(a=instruction[15], b=instruction[0], out=is0);
    And(a=instruction[15], b=instruction[1], out=is1);
    And(a=instruction[15], b=instruction[2], out=is2);
    

    // A register
    // if A instruction (i=0) load in A instruction
    // else
    // if instruction[5] = 0 don't load ALU output keep same value
    // else load ALU output

    // if is A instruction load input which is instruction
    // if is C instruction and instruction[5] = 1, load ALU output
    // only if is C instruction with instruction[5] = 0, no load
    Not(in=instruction[15], out=isA);
    Or(a=isA, b=loadina, out=AorMaybeAlu);

    ARegister(in=ainput, load=AorMaybeAlu, out=outa, out[0..14]=addressM);

    // a bit of the instruction tells wether the ALU operates on A register or memory input
    Mux16(a=outa, b=inM, sel=instruction[12], out=outam);

    // write to M
    And(a=is3, b=true, out=writeM);

    // ALU
    ALU(x=outd, y=outam, zx=is11, nx=is10, zy=is9, ny=is8, f=is7, no=is6, out=outM, out=outalu, zr=zr, ng=ng);

    // D register
    DRegister(in=outalu, load=is4, out=outd);


    // logic for jump/next instruction
    And(a=ng, b=is2, out=jnegative);
    And(a=zr, b=is1, out=jzero);
    Or(a=jnegative, b=jzero, out=jnegzero);

    Not(in=ng, out=notnegative);
    Not(in=zr, out=notzero);
    And(a=notnegative, b=notzero, out=notnegzero);
    And(a=notnegzero, b=is0, out=jpositive);

    Or(a=jnegzero, b=jpositive, out=jump);
    Not(in=jump, out=notjump);


    // program counter
    PC(in=outa, reset=reset, load=jump, inc=notjump, out[0..14]=pc);
	
}

