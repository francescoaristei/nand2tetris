/**
 * Computes the sum of two bits.
 * It is sufficient to notice that
 * Given the truth table for the chip:
 * a  b    carry    sum
 * 0  0    0        0
 * 0  1    0        1
 * 1  0    0        1
 * 1  1    1        0
 * The carry has the truth table of the AND and the sum of the XOR.
 */
CHIP HalfAdder {
    IN a, b;    // 1-bit inputs
    OUT sum,    // Right bit of a + b 
        carry;  // Left bit of a + b

    PARTS:
    And(a=a, b=b, out=carry);
    Xor(a=a, b=b, out=sum);
}